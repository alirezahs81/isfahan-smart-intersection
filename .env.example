# ============================================================
# Isfahan Smart Intersection - Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Camera RTSP Streams (8 cameras)
# ------------------------------------------------------------
CAM_01_RTSP=rtsp://admin:PASSWORD@10.100.50.21:554/stream1
CAM_02_RTSP=rtsp://admin:PASSWORD@10.100.50.22:554/stream1
CAM_03_RTSP=rtsp://admin:PASSWORD@10.100.50.23:554/stream1
CAM_04_RTSP=rtsp://admin:PASSWORD@10.100.50.24:554/stream1
CAM_05_RTSP=rtsp://admin:PASSWORD@10.100.50.25:554/stream1
CAM_06_RTSP=rtsp://admin:PASSWORD@10.100.50.26:554/stream1
CAM_07_RTSP=rtsp://admin:PASSWORD@10.100.50.27:554/stream1
CAM_08_RTSP=rtsp://admin:PASSWORD@10.100.50.28:554/stream1

# ------------------------------------------------------------
# MQTT Configuration (Isfahan UTC/SCADA)
# ------------------------------------------------------------
MQTT_BROKER=isfahan-utc.municipality.ir
MQTT_PORT=8883
MQTT_USERNAME=isfahan_edge_client
MQTT_PASSWORD=CHANGE_ME_SECURE_PASSWORD
MQTT_CLIENT_ID=isfahan-edge-chaharbag-01

# Local MQTT (for DeepStream ↔ Bridge)
LOCAL_MQTT_BROKER=localhost
LOCAL_MQTT_PORT=1883

# ------------------------------------------------------------
# TLS Certificates (for secure MQTT/HTTPS)
# Place certs in ./certs/ directory
# ------------------------------------------------------------
TLS_CA_CERT=/certs/ca.crt
TLS_CLIENT_CERT=/certs/client.crt
TLS_CLIENT_KEY=/certs/client.key
TLS_INSECURE=false

# ------------------------------------------------------------
# Alert Webhooks
# ------------------------------------------------------------
ALERT_WEBHOOK=https://alerts.isfahan.municipality.ir/webhook
ALERT_WEBHOOK_TIMEOUT=10

# ------------------------------------------------------------
# API Endpoints
# ------------------------------------------------------------
CMS_API=https://cms.isfahan.municipality.ir/api/v1
UTC_API=https://utc.isfahan.municipality.ir/api/v1
SCADA_API=https://scada.isfahan.municipality.ir/api/v1

# ------------------------------------------------------------
# Model Paths (auto-populated after training)
# ------------------------------------------------------------
YOLO_MODEL_PATH=models/detection/weights/yolov10n_isfahan_int8.engine
REID_MODEL_PATH=models/tracking/weights/osnet_x1_0_isfahan.engine
ANOMALY_MODEL_PATH=models/anomaly/weights/stgcn_isfahan.onnx
SIGNAL_RL_MODEL_PATH=models/signal_rl/weights/ppo_gat_isfahan.pt

# ------------------------------------------------------------
# Training Configuration
# ------------------------------------------------------------
TRAIN_GPUS=0,1,2,3
TRAIN_BATCH_SIZE=64
TRAIN_EPOCHS=150
SYNTHETIC_FRAMES=50000

# ------------------------------------------------------------
# Deployment
# ------------------------------------------------------------
EDGE_DEVICE=jetson_orin_agx_64gb
JETPACK_VERSION=6.0
DOCKER_REGISTRY=registry.isfahan.municipality.ir
DEPLOYMENT_ENV=production  # development, staging, production

# ------------------------------------------------------------
# Logging & Monitoring
# ------------------------------------------------------------
LOG_LEVEL=INFO
PROMETHEUS_PORT=9090
HEALTH_PORT=9091
GRAFANA_PORT=3000

# ------------------------------------------------------------
# Timezone
# ------------------------------------------------------------
TZ=Asia/Tehran